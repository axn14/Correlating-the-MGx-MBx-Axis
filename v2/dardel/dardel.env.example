# Copy to dardel.env (gitignored) and fill in. Sourced by the laptop-side scripts
# (02_stage_inputs.sh, pull_results.sh). Values below are examples, not defaults.
#
# Confirm PDC_STORAGE on Dardel with `projinfo` before filling it in: the PDC docs
# are inconsistent between /cfs/klemming/projects/snic/<project> and
# /cfs/klemming/<project>/<user>, and only your own projinfo output is authoritative.

PDC_HOST=dardel.pdc.kth.se
PDC_USER=your-pdc-username

# Private key for PDC, if it is not at one of ssh's default identity names
# (id_ed25519, id_rsa, ...). MobaXterm names its key id-ed25519-pdc, which ssh will
# NOT find on its own, so set it here or every call falls back to asking for a
# password. Leave empty to rely on ssh's defaults or on an agent that already holds
# the key. In MobaXterm's local shell ~ is Documents\MobaXterm\home.
#   MobaXterm : ~/.ssh/id-ed25519-pdc
#   WSL       : ~/.ssh/id-ed25519-pdc   (copy it in and chmod 600; a key on /mnt/c
#               is world-readable to ssh, which refuses to use it)
PDC_SSH_KEY=

# The SLURM allocation passed as `sbatch -A`. This is the COMPUTE project, which is
# not necessarily spelled the same as the storage directory below.
PDC_PROJECT=naiss2026-22-000

# Project storage root on Klemming. Not backed up; deleted 3 months after the
# project ends. Everything heavy lives under here.
PDC_STORAGE=/cfs/klemming/projects/snic/your-project-name

# Where this project's tree lives on Dardel. Must contain v2/ and Data/ after
# staging; Results/ is created by the first run.
REMOTE_ROOT=${PDC_STORAGE}/ki

# The laptop-side checkout. WSL path, since rsync runs under WSL on Windows.
# QUOTE these two: the paths contain a space, and this file is sourced by bash.
LOCAL_ROOT="/mnt/d/KI Research"

# Where pulled runs land. MUST NOT be inside ${LOCAL_ROOT}/Results -- pull_results.sh
# refuses if it is, because run_pipeline.py moves and prunes that tree.
LOCAL_PULL="/mnt/d/KI Research-dardel"
